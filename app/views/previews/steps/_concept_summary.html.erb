<%
  my_votes_by_concept = @my_concept_votes.index_by(&:concept_id)
  rated_concepts = @video.concepts.select { |c| my_votes_by_concept[c.id] }
  sorted_by_interest = rated_concepts.sort_by { |c| -my_votes_by_concept[c.id].interest_score }
  top_rated = sorted_by_interest.first
  picked = @video.picked_concept
%>

<% if rated_concepts.any? %>
  <div class="mb-8">
    <h2 class="text-lg font-medium text-[#0f0f0f] mb-4">Concept planning</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <!-- Your top-rated concept -->
      <div class="bg-white rounded-xl border border-[#e5e5e5] overflow-hidden">
        <div class="px-5 py-3 border-b border-[#e5e5e5] bg-[#f9f9f9]">
          <span class="text-sm font-medium text-[#0f0f0f]">Your highest-rated concept</span>
        </div>
        <div class="p-5">
          <% if top_rated %>
            <% vote = my_votes_by_concept[top_rated.id] %>
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <h3 class="text-lg font-medium text-[#0f0f0f]"><%= top_rated.name %></h3>
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-[#065fd4] text-white"><%= vote.interest_score %>/10</span>
              <% if top_rated.picked %>
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">Also picked!</span>
              <% end %>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% top_rated.concept_pairs.each do |pair| %>
                <div>
                  <div class="relative aspect-video bg-[#e5e5e5] rounded-lg overflow-hidden mb-2">
                    <% if pair.has_thumbnail? %>
                      <%= thumbnail_image_tag pair %>
                    <% end %>
                  </div>
                  <p class="text-xs text-[#0f0f0f] line-clamp-2 font-medium"><%= pair.title %></p>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Picked concept -->
      <div class="bg-white rounded-xl border border-[#e5e5e5] overflow-hidden">
        <div class="px-5 py-3 border-b border-[#e5e5e5] <%= picked ? 'bg-green-50' : 'bg-[#f9f9f9]' %>">
          <span class="text-sm font-medium text-[#0f0f0f]">Picked concept</span>
        </div>
        <div class="p-5">
          <% if picked %>
            <% my_pick_vote = my_votes_by_concept[picked.id] %>
            <div class="flex items-center gap-3 mb-4 flex-wrap">
              <h3 class="text-lg font-medium text-[#0f0f0f]"><%= picked.name %></h3>
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-green-500 text-white flex items-center gap-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                Selected
              </span>
              <% if my_pick_vote %>
                <span class="text-xs text-[#606060]">You rated: <%= my_pick_vote.interest_score %>/10</span>
              <% end %>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% picked.concept_pairs.each do |pair| %>
                <div>
                  <div class="relative aspect-video bg-[#e5e5e5] rounded-lg overflow-hidden mb-2">
                    <% if pair.has_thumbnail? %>
                      <%= thumbnail_image_tag pair %>
                    <% end %>
                  </div>
                  <p class="text-xs text-[#0f0f0f] line-clamp-2 font-medium"><%= pair.title %></p>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <svg class="w-10 h-10 text-[#ccc] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <p class="text-sm text-[#909090]">The creator hasn't picked a concept yet.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- All your ratings -->
    <div class="bg-white rounded-xl border border-[#e5e5e5] overflow-hidden">
      <div class="px-5 py-3 border-b border-[#e5e5e5] bg-[#f9f9f9]">
        <span class="text-sm font-medium text-[#0f0f0f]">All your concept ratings</span>
      </div>
      <div class="divide-y divide-[#e5e5e5]">
        <% sorted_by_interest.each do |concept| %>
          <% vote = my_votes_by_concept[concept.id] %>
          <div class="px-5 py-4">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="text-sm font-medium text-[#0f0f0f]"><%= concept.name %></span>
                <% if concept.picked %>
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">Picked</span>
                <% end %>
                <% if concept.id == top_rated&.id %>
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-[#065fd4]/10 text-[#065fd4]">Your top pick</span>
                <% end %>
              </div>
              <span class="text-sm font-medium text-[#606060]"><%= vote.interest_score %>/10</span>
            </div>
            <% if vote.concept_thoughts.present? || vote.improvement_suggestions.present? %>
              <div class="space-y-2 pl-0 sm:pl-1">
                <% if vote.concept_thoughts.present? %>
                  <div>
                    <p class="text-xs font-medium text-[#909090]">What do you think of this concept?</p>
                    <p class="text-sm text-[#606060] leading-relaxed"><%= vote.concept_thoughts %></p>
                  </div>
                <% end %>
                <% if vote.improvement_suggestions.present? %>
                  <div>
                    <p class="text-xs font-medium text-[#909090]">How could the concept, thumbnail, or title be improved?</p>
                    <p class="text-sm text-[#606060] leading-relaxed"><%= vote.improvement_suggestions %></p>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
