<%
  all_pairs_flat = @video.variants.flat_map(&:title_thumbnail_pairs)
  pairs_by_variant = @video.variants.map { |v| [v, v.title_thumbnail_pairs] }
  has_winner = all_pairs_flat.any?(&:ab_winner)
  ab_selected_count = all_pairs_flat.count(&:ab_selected)
  winner_pair = all_pairs_flat.detect(&:ab_winner)
%>
<!-- A/B Test Results Panel -->
<details class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-8 group/ab" <%= 'open' unless has_winner %>>
  <summary class="px-5 py-4 bg-gray-50 flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden hover:bg-gray-100 transition">
    <div class="flex items-center gap-3">
      <svg class="w-4 h-4 text-gray-400 transition-transform group-open/ab:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <div>
        <h3 class="text-sm font-semibold text-gray-900">A/B Test Results</h3>
        <p class="text-xs text-gray-500 mt-0.5">
          <% if has_winner %>
            Winner: <strong><%= winner_pair.title.truncate(50) %></strong>
          <% elsif ab_selected_count > 0 %>
            <%= ab_selected_count %> thumbnail<%= ab_selected_count == 1 ? '' : 's' %> selected for A/B &middot; No winner yet
          <% else %>
            Click thumbnails to mark them as A/B tested on YouTube.
          <% end %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2" onclick="event.stopPropagation();">
      <% if has_winner %>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700 flex items-center gap-1">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
          Winner selected
        </span>
      <% elsif ab_selected_count > 0 %>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-purple-100 text-purple-700"><%= ab_selected_count %> A/B tested</span>
      <% end %>
    </div>
  </summary>
  <div data-controller="ab-results">
  <%= form_tag update_ab_results_admin_video_path(@video), method: :patch do %>
    <div data-ab-results-target="abInputs">
      <% all_pairs_flat.select(&:ab_selected).each do |pair| %>
        <input type="hidden" name="ab_selected_pair_ids[]" value="<%= pair.id %>">
      <% end %>
    </div>
    <input type="hidden" name="ab_winner_pair_id" value="<%= all_pairs_flat.detect(&:ab_winner)&.id %>" data-ab-results-target="winnerInput">
    <div class="px-5 py-5">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Selected for A/B testing <span class="normal-case font-normal">(click to toggle)</span></p>
      <% pairs_by_variant.each do |variant, pairs| %>
        <p class="text-sm font-medium text-gray-700 mt-4 mb-3"><%= variant.name %></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-6">
          <% pairs.each do |pair| %>
            <div class="group cursor-pointer select-none"
                 data-ab-results-target="abCard"
                 data-pair-id="<%= pair.id %>"
                 data-preselected="<%= pair.ab_selected %>"
                 data-action="click->ab-results#toggleAb">
              <div class="relative aspect-video bg-gray-200 rounded-xl overflow-hidden mb-3">
                <% if pair.has_thumbnail? %>
                  <% if pair.thumbnail.attached? %>
                    <%= image_tag pair.thumbnail, class: "w-full h-full object-cover" %>
                  <% else %>
                    <img src="<%= pair.thumbnail_url %>" class="w-full h-full object-cover" alt="">
                  <% end %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                  </div>
                <% end %>
                <% if @video.video_duration.present? %>
                  <span class="absolute bottom-1 right-1 bg-black/80 text-white font-medium px-1 rounded z-10" style="font-size: 11px; line-height: 16px; letter-spacing: 0.5px;"><%= @video.video_duration %></span>
                <% end %>
                <div data-ab-badge class="absolute top-2 left-2 bg-purple-600 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow z-10 <%= 'hidden' unless pair.ab_selected %>">
                  A/B
                </div>
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all flex items-center justify-center opacity-0 group-hover:opacity-100 pointer-events-none">
                  <span class="bg-white/95 backdrop-blur-sm text-gray-900 text-xs font-medium px-3 py-1.5 rounded-full shadow-sm">Click to toggle</span>
                </div>
                <div data-ab-overlay class="absolute inset-0 bg-purple-600/10 pointer-events-none <%= 'hidden' unless pair.ab_selected %>"></div>
              </div>
              <div class="flex gap-3">
                <% if current_admin.avatar_url %>
                  <img src="<%= current_admin.avatar_url %>" class="w-9 h-9 rounded-full flex-shrink-0" alt="" referrerpolicy="no-referrer">
                <% else %>
                  <div class="w-9 h-9 rounded-full bg-red-600 flex items-center justify-center text-white text-sm font-medium flex-shrink-0">
                    <%= current_admin.yt_username[0].upcase %>
                  </div>
                <% end %>
                <div class="flex-1 min-w-0">
                  <h4 class="text-sm font-medium text-gray-900 leading-5 line-clamp-2"><%= pair.title %></h4>
                  <p class="text-xs text-gray-500 mt-1"><%= current_admin.yt_username %></p>
                  <p class="text-xs text-gray-500"><%= @video.sample_views %> &middot; 1 hour ago</p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Winner Section -->
    <div class="px-5 py-5 border-t border-gray-200">
      <div class="flex items-center justify-between mb-1">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">A/B test winner <span class="normal-case font-normal">(optional — click to select)</span></p>
        <button type="button" data-action="click->ab-results#clearWinner" class="text-xs text-gray-400 hover:text-gray-600 cursor-pointer">Clear winner</button>
      </div>
      <% pairs_by_variant.each do |variant, pairs| %>
        <p class="text-sm font-medium text-gray-700 mt-4 mb-3"><%= variant.name %></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-6">
          <% pairs.each do |pair| %>
            <div class="group cursor-pointer select-none"
                 data-ab-results-target="winnerCard"
                 data-pair-id="<%= pair.id %>"
                 data-preselected="<%= pair.ab_winner %>"
                 data-action="click->ab-results#selectWinner">
              <div class="relative aspect-video bg-gray-200 rounded-xl overflow-hidden mb-3">
                <% if pair.has_thumbnail? %>
                  <% if pair.thumbnail.attached? %>
                    <%= image_tag pair.thumbnail, class: "w-full h-full object-cover" %>
                  <% else %>
                    <img src="<%= pair.thumbnail_url %>" class="w-full h-full object-cover" alt="">
                  <% end %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                  </div>
                <% end %>
                <% if @video.video_duration.present? %>
                  <span class="absolute bottom-1 right-1 bg-black/80 text-white font-medium px-1 rounded z-10" style="font-size: 11px; line-height: 16px; letter-spacing: 0.5px;"><%= @video.video_duration %></span>
                <% end %>
                <div data-winner-badge class="absolute top-2 left-2 bg-green-500 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow z-10 flex items-center gap-1 <%= 'hidden' unless pair.ab_winner %>">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                  Winner
                </div>
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all flex items-center justify-center opacity-0 group-hover:opacity-100 pointer-events-none">
                  <span class="bg-white/95 backdrop-blur-sm text-gray-900 text-xs font-medium px-3 py-1.5 rounded-full shadow-sm">Click to select</span>
                </div>
                <div data-winner-overlay class="absolute inset-0 bg-green-500/10 pointer-events-none <%= 'hidden' unless pair.ab_winner %>"></div>
              </div>
              <div class="flex gap-3">
                <% if current_admin.avatar_url %>
                  <img src="<%= current_admin.avatar_url %>" class="w-9 h-9 rounded-full flex-shrink-0" alt="" referrerpolicy="no-referrer">
                <% else %>
                  <div class="w-9 h-9 rounded-full bg-red-600 flex items-center justify-center text-white text-sm font-medium flex-shrink-0">
                    <%= current_admin.yt_username[0].upcase %>
                  </div>
                <% end %>
                <div class="flex-1 min-w-0">
                  <h4 class="text-sm font-medium text-gray-900 leading-5 line-clamp-2"><%= pair.title %></h4>
                  <p class="text-xs text-gray-500 mt-1"><%= current_admin.yt_username %></p>
                  <p class="text-xs text-gray-500"><%= @video.sample_views %> &middot; 1 hour ago</p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="px-5 py-4 border-t border-gray-200 bg-gray-50">
      <%= submit_tag "Save A/B Results", class: "bg-purple-600 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 transition cursor-pointer" %>
    </div>
  <% end %>
  </div>
</details>
