<%
  concept_voter_count = @video.concepts.flat_map(&:concept_votes).map(&:voter_name).uniq.size
%>
<div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-8">
  <div class="px-5 py-4 bg-gray-50 border-b border-gray-200">
    <h3 class="text-sm font-semibold text-gray-900">Concept Results</h3>
    <p class="text-xs text-gray-500 mt-0.5">
      <% if concept_voter_count > 0 %>
        <%= concept_voter_count %> voter<%= concept_voter_count == 1 ? '' : 's' %>
      <% else %>
        No concept ratings yet
      <% end %>
    </p>
  </div>

  <% if @video.concepts.any? { |c| c.concept_votes.any? } %>
    <div class="px-5 py-4 border-b border-gray-200">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Concept Interest Ratings</p>
      <%
        concept_scores = @video.concepts.map do |c|
          votes = c.concept_votes
          avg = votes.any? ? (votes.sum(&:interest_score).to_f / votes.size).round(1) : 0
          [c, avg, votes.size]
        end.sort_by { |_, avg, _| -avg }
        max_avg = concept_scores.first&.at(1) || 0
      %>
      <div class="space-y-2">
        <% concept_scores.each do |concept, avg, count| %>
          <% next if count == 0 %>
          <% pct = max_avg > 0 ? (avg / max_avg * 100).round : 0 %>
          <% is_leader = avg == max_avg && avg > 0 %>
          <div class="flex items-center gap-3">
            <span class="text-sm text-gray-700 w-36 truncate font-medium flex items-center gap-1.5">
              <% if concept.picked %>
                <span class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></span>
              <% elsif is_leader %>
                <span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0"></span>
              <% end %>
              <%= concept.name %>
              <% if concept.picked %>
                <span class="text-[10px] text-green-600 font-normal">(picked)</span>
              <% end %>
            </span>
            <div class="flex-1 bg-gray-100 rounded-full h-6 overflow-hidden">
              <div class="<%= concept.picked ? 'bg-green-500' : is_leader ? 'bg-amber-400' : 'bg-amber-300' %> h-full rounded-full transition-all flex items-center pl-2" style="width: <%= [pct, 2].max %>%">
                <% if pct >= 15 %>
                  <span class="text-xs text-white font-medium"><%= avg %>/10</span>
                <% end %>
              </div>
            </div>
            <span class="text-sm text-gray-500 w-20 text-right whitespace-nowrap"><%= avg %>/10 (<%= count %>)</span>
          </div>
        <% end %>
      </div>
    </div>

    <% concept_feedback = @video.concepts.flat_map { |c| c.concept_votes.map { |v| [c, v] } } %>
    <% if concept_feedback.any? %>
      <div class="px-5 py-4">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Concept Feedback</p>
        <div class="space-y-4">
          <% @video.concepts.each do |concept| %>
            <% votes = concept.concept_votes.sort_by(&:voter_name) %>
            <% next if votes.empty? %>
            <div>
              <p class="text-sm font-medium text-gray-700 mb-2"><%= concept.name %></p>
              <div class="space-y-3">
                <% votes.each do |vote| %>
                  <div class="p-3 rounded-lg bg-gray-50">
                    <div class="flex items-center gap-2 mb-2">
                      <div class="w-6 h-6 rounded-full bg-purple-600 flex items-center justify-center text-white text-xs font-medium flex-shrink-0">
                        <%= vote.voter_name[0].upcase %>
                      </div>
                      <span class="text-sm font-medium text-gray-900"><%= vote.voter_name %></span>
                      <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-100 text-amber-700"><%= vote.interest_score %>/10</span>
                    </div>
                    <div class="space-y-2 pl-8">
                      <div>
                        <p class="text-xs font-medium text-gray-500">What do you think of this concept?</p>
                        <p class="text-sm text-gray-700 leading-relaxed"><%= vote.concept_thoughts.presence || "—" %></p>
                      </div>
                      <div>
                        <p class="text-xs font-medium text-gray-500">How could the concept, thumbnail, or title be improved?</p>
                        <p class="text-sm text-gray-700 leading-relaxed"><%= vote.improvement_suggestions.presence || "—" %></p>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="px-5 py-12 text-center">
      <p class="text-sm text-gray-400">No concept ratings yet. Share the preview link during concept planning.</p>
    </div>
  <% end %>
</div>
