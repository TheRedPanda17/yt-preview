<!-- Concept Planning -->
<div class="flex justify-between items-center mb-4">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Concept Planning</h2>
    <p class="text-sm text-gray-500 mt-0.5">Add video concepts with title/thumbnail pairs for voters to rate.</p>
  </div>
  <div class="flex items-center gap-2 flex-shrink-0 ml-4">
    <% if @video.voting? %>
      <%= button_to "Begin Concept Planning", begin_concept_planning_admin_video_path(@video), method: :patch, class: "text-sm bg-gray-100 text-gray-700 px-3 py-1.5 rounded-md hover:bg-gray-200 transition cursor-pointer whitespace-nowrap" %>
    <% end %>
    <%= link_to "Add Concept", new_admin_video_concept_path(@video), class: "text-sm bg-red-600 text-white px-3 py-1.5 rounded-md hover:bg-red-700 transition whitespace-nowrap" %>
  </div>
</div>

<% if @video.concepts.empty? %>
  <div class="text-center py-12 bg-white rounded-xl border border-gray-200 mb-8">
    <p class="text-gray-500 mb-3">No concepts yet</p>
    <p class="text-sm text-gray-400 mb-4">Create concepts like "Experiential" or "Analytical", then add title/thumbnail pairs to each.</p>
    <%= link_to "Add Concept", new_admin_video_concept_path(@video), class: "inline-block text-sm bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition" %>
  </div>
<% else %>
  <div class="space-y-8 mb-8">
    <% @video.concepts.each do |concept| %>
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="flex justify-between items-center px-5 py-3 bg-gray-50 border-b border-gray-200">
          <div class="flex items-center gap-3 min-w-0">
            <h3 class="font-semibold text-gray-900"><%= concept.name %></h3>
            <% if concept.picked %>
              <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700 flex items-center gap-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                Picked
              </span>
            <% end %>
            <span class="text-xs text-gray-500"><%= concept.concept_pairs.size %> pair<%= concept.concept_pairs.size == 1 ? '' : 's' %></span>
            <% if concept.concept_votes.any? %>
              <% avg = (concept.concept_votes.sum(&:interest_score).to_f / concept.concept_votes.size).round(1) %>
              <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full"><%= avg %>/10 avg &middot; <%= concept.concept_votes.size %> vote<%= concept.concept_votes.size == 1 ? '' : 's' %></span>
            <% end %>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0 ml-4">
            <% unless concept.picked %>
              <%= button_to "Pick Concept", pick_admin_video_concept_path(@video, concept), method: :patch, class: "text-xs bg-green-600 text-white px-2.5 py-1 rounded-md hover:bg-green-700 transition cursor-pointer" %>
            <% end %>
            <%= button_to move_admin_video_concept_path(@video, concept, direction: "up"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            <% end %>
            <%= button_to move_admin_video_concept_path(@video, concept, direction: "down"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            <% end %>
            <span class="text-gray-200">|</span>
            <%= link_to "Add Pair", new_admin_video_concept_concept_pair_path(@video, concept), class: "text-xs bg-gray-200 text-gray-700 px-2.5 py-1 rounded-md hover:bg-gray-300 transition" %>
            <%= link_to "Edit", edit_admin_video_concept_path(@video, concept), class: "text-xs text-gray-500 hover:text-gray-700" %>
            <%= button_to "Remove", admin_video_concept_path(@video, concept), method: :delete, class: "text-xs text-red-500 hover:text-red-700", data: { turbo_confirm: "Delete this concept?" } %>
          </div>
        </div>

        <div class="p-5">
          <% if concept.concept_pairs.empty? %>
            <p class="text-sm text-gray-400 text-center py-4">No pairs yet. <%= link_to "Add one", new_admin_video_concept_concept_pair_path(@video, concept), class: "text-red-600 hover:text-red-700" %></p>
          <% else %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <% concept.concept_pairs.each do |pair| %>
                <div class="group relative">
                  <div class="yt-card">
                    <div class="relative aspect-video bg-gray-200 rounded-xl overflow-hidden">
                      <% if pair.has_thumbnail? %>
                        <% if pair.thumbnail.attached? %>
                          <%= image_tag pair.thumbnail, class: "w-full h-full object-cover" %>
                        <% else %>
                          <img src="<%= pair.thumbnail_url %>" class="w-full h-full object-cover" alt="" loading="lazy">
                        <% end %>
                      <% else %>
                        <div class="w-full h-full flex items-center justify-center text-gray-400">
                          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        </div>
                      <% end %>
                      <% if @video.video_duration.present? %>
                        <span class="absolute bottom-1 right-1 bg-black/80 text-white font-medium px-1 rounded" style="font-size: 11px; line-height: 16px; letter-spacing: 0.5px;"><%= @video.video_duration %></span>
                      <% end %>
                    </div>
                    <div class="flex gap-3 mt-3">
                      <% if current_admin.avatar_url %>
                        <img src="<%= current_admin.avatar_url %>" class="w-9 h-9 rounded-full flex-shrink-0" alt="" referrerpolicy="no-referrer">
                      <% else %>
                        <div class="w-9 h-9 rounded-full bg-red-600 flex items-center justify-center text-white text-sm font-medium flex-shrink-0">
                          <%= current_admin.yt_username[0].upcase %>
                        </div>
                      <% end %>
                      <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-medium text-gray-900 leading-5 line-clamp-2"><%= pair.title %></h4>
                        <p class="text-xs text-gray-500 mt-1"><%= current_admin.yt_username %></p>
                        <p class="text-xs text-gray-500"><%= @video.sample_views %> &middot; 1 hour ago</p>
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 mt-2 opacity-0 group-hover:opacity-100 transition">
                    <%= button_to move_admin_video_concept_concept_pair_path(@video, concept, pair, direction: "up"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    <% end %>
                    <%= button_to move_admin_video_concept_concept_pair_path(@video, concept, pair, direction: "down"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    <% end %>
                    <%= link_to "Edit", edit_admin_video_concept_concept_pair_path(@video, concept, pair), class: "text-xs text-gray-500 hover:text-gray-700" %>
                    <%= button_to "Remove", admin_video_concept_concept_pair_path(@video, concept, pair), method: :delete, class: "text-xs text-red-500 hover:text-red-700", data: { turbo_confirm: "Delete this pair?" } %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
