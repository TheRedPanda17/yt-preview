<% picked = @video.picked_concept %>
<% concept_count = @video.concepts.size %>

<% if picked %>
<details class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-8 group/details">
  <summary class="px-5 py-4 bg-gray-50 flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden hover:bg-gray-100 transition">
    <div class="flex items-center gap-3 min-w-0">
      <svg class="w-4 h-4 text-gray-400 transition-transform group-open/details:rotate-90 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <div class="min-w-0">
        <h3 class="text-sm font-semibold text-gray-900">Concept Planning</h3>
        <p class="text-xs text-gray-500 mt-0.5 truncate">
          <%= concept_count %> concept<%= concept_count == 1 ? '' : 's' %>
          &middot; Picked: <span class="text-green-700 font-medium"><%= picked.name %></span>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0 ml-4" onclick="event.stopPropagation();">
      <% if @video.voting? %>
        <%= button_to "Begin Concept Planning", begin_concept_planning_admin_video_path(@video), method: :patch, class: "text-sm bg-gray-100 text-gray-700 px-3 py-1.5 rounded-md hover:bg-gray-200 transition cursor-pointer whitespace-nowrap" %>
      <% end %>
      <%= link_to "Add Concept", new_admin_video_concept_path(@video), class: "text-sm bg-red-600 text-white px-3 py-1.5 rounded-md hover:bg-red-700 transition whitespace-nowrap" %>
    </div>
  </summary>

  <div class="px-5 py-4 border-t border-gray-200">
    <%= render "concepts_list", collapsed: true %>
  </div>
</details>
<% else %>
<!-- Concept Planning -->
<div class="flex justify-between items-center mb-4">
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Concept Planning</h2>
    <p class="text-sm text-gray-500 mt-0.5">Add video concepts with title/thumbnail pairs for voters to rate.</p>
  </div>
  <div class="flex items-center gap-2 flex-shrink-0 ml-4">
    <% if @video.voting? %>
      <%= button_to "Begin Concept Planning", begin_concept_planning_admin_video_path(@video), method: :patch, class: "text-sm bg-gray-100 text-gray-700 px-3 py-1.5 rounded-md hover:bg-gray-200 transition cursor-pointer whitespace-nowrap" %>
    <% end %>
    <%= link_to "Add Concept", new_admin_video_concept_path(@video), class: "text-sm bg-red-600 text-white px-3 py-1.5 rounded-md hover:bg-red-700 transition whitespace-nowrap" %>
  </div>
</div>

<%= render "concepts_list", collapsed: false %>
<% end %>
