<div class="mb-6">
  <%= link_to "&larr; Back to videos".html_safe, admin_videos_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <div class="flex items-center gap-3 mt-2">
    <h1 class="text-2xl font-bold text-gray-900"><%= @video.working_title %></h1>
    <% if @video.ended? %>
      <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-purple-100 text-purple-700">Ended</span>
    <% elsif @video.concept_planning? %>
      <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-amber-100 text-amber-700">Concept Planning</span>
    <% else %>
      <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-green-100 text-green-700">Voting</span>
    <% end %>
  </div>
  <p class="text-sm text-gray-500 mt-1">Sample views: <%= @video.sample_views %></p>

  <%
    toolbar_btn = "text-sm px-3 py-1.5 rounded-md whitespace-nowrap inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 hover:bg-gray-200 transition"
    toolbar_btn_danger = "text-sm px-3 py-1.5 rounded-md whitespace-nowrap inline-flex items-center gap-1.5 bg-red-50 text-red-600 hover:bg-red-100 transition cursor-pointer"
  %>
  <div class="mt-4 flex w-full flex-wrap items-center justify-between gap-x-6 gap-y-3 [&_form]:inline-flex [&_form]:shrink-0 [&>a]:shrink-0">
    <% if @video.concept_planning? %>
      <%= button_to advance_to_voting_admin_video_path(@video), method: :patch, form: { class: "inline-flex" }, class: "#{toolbar_btn} cursor-pointer", data: { turbo_confirm: "Move to thumbnail voting? Make sure you've picked a concept first." } do %>
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        Advance to Thumbnail Voting
      <% end %>
    <% elsif @video.voting? %>
      <%= button_to end_voting_admin_video_path(@video), method: :patch, form: { class: "inline-flex" }, class: "#{toolbar_btn} cursor-pointer", data: { turbo_confirm: "End voting for this video? Voters will see the results page instead." } do %>
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        End Voting
      <% end %>
    <% else %>
      <%= button_to reopen_voting_admin_video_path(@video), method: :patch, form: { class: "inline-flex" }, class: "#{toolbar_btn} cursor-pointer", data: { turbo_confirm: "Reopen voting? Voters will be able to vote again." } do %>
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        Reopen Voting
      <% end %>
    <% end %>
    <%= link_to concept_results_admin_video_path(@video), class: toolbar_btn do %>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
      Concept Results
    <% end %>
    <%= link_to voting_results_admin_video_path(@video), class: toolbar_btn do %>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
      Voting Results
    <% end %>
    <%= link_to preview_voting_admin_video_path(@video), class: toolbar_btn, target: "_blank" do %>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
      Preview Voting Page
    <% end %>
    <%= link_to compose_admin_video_path(@video), class: toolbar_btn do %>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
      Create Pairs
    <% end %>
    <%= link_to channel_preview_admin_video_path(@video), class: toolbar_btn do %>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
      Channel Preview
    <% end %>
    <%= link_to edit_admin_video_path(@video), class: toolbar_btn do %>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
      Edit
    <% end %>
    <%= button_to admin_video_path(@video), method: :delete, form: { class: "inline-flex" }, class: toolbar_btn_danger, data: { turbo_confirm: "Delete this video and all its variants?" } do %>
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
      Delete
    <% end %>
  </div>
</div>

<%= render "concepts" %>

<!-- Share with Recipients -->
<% video_shares = @video.video_shares.includes(:recipient).order("recipients.name") %>
<%
  # Precompute vote progress for summary
  variants_with_pairs = @video.variants.select { |v| v.title_thumbnail_pairs.any? }
  total_pair_slots = variants_with_pairs.size
  total_variant_count_for_summary = @video.variants.size
  votes_all_done = 0
  votes_in_progress = 0
  votes_not_started = 0
  video_shares.each do |share|
    name = share.recipient.name
    vr_count = @video.variant_votes.count { |v| v.voter_name == name }
    has_all_variants = vr_count == total_variant_count_for_summary && total_variant_count_for_summary > 0
    pv_cast = variants_with_pairs.count { |v| v.pair_votes.any? { |pv| pv.voter_name == name } }
    if has_all_variants && pv_cast == total_pair_slots && total_pair_slots > 0
      votes_all_done += 1
    elsif vr_count > 0 || pv_cast > 0
      votes_in_progress += 1
    else
      votes_not_started += 1
    end
  end
%>
<details class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-8 group/details">
  <summary class="px-5 py-4 bg-gray-50 flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden hover:bg-gray-100 transition">
    <div class="flex items-center gap-3">
      <svg class="w-4 h-4 text-gray-400 transition-transform group-open/details:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      <div>
        <h3 class="text-sm font-semibold text-gray-900">Shared With</h3>
        <p class="text-xs text-gray-500 mt-0.5">
          <% if video_shares.any? %>
            <%= video_shares.size %> recipient<%= video_shares.size == 1 ? '' : 's' %>
          <% else %>
            No one yet
          <% end %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <% if video_shares.any? %>
        <div class="flex items-center gap-1.5" onclick="event.stopPropagation();">
          <% if votes_all_done > 0 %>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700"><%= votes_all_done %> complete</span>
          <% end %>
          <% if votes_in_progress > 0 %>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-100 text-amber-700"><%= votes_in_progress %> in progress</span>
          <% end %>
          <% if votes_not_started > 0 %>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-500"><%= votes_not_started %> pending</span>
          <% end %>
        </div>
      <% end %>
      <%= link_to "Manage Recipients", admin_recipients_path, class: "text-xs text-blue-600 hover:text-blue-800 font-medium", onclick: "event.stopPropagation();" %>
    </div>
  </summary>

  <div class="px-5 py-4 border-t border-gray-200">
    <!-- Share with existing recipient -->
    <% unshared_recipients = current_admin.recipients.where.not(id: @video.recipients.select(:id)).order(:name) %>
    <% if unshared_recipients.any? %>
      <div class="flex flex-wrap gap-2 mb-4">
        <% unshared_recipients.each do |recipient| %>
          <%= button_to admin_video_video_shares_path(@video, recipient_id: recipient.id), method: :post, class: "inline-flex items-center gap-1.5 text-sm bg-gray-100 text-gray-700 px-3 py-1.5 rounded-full hover:bg-blue-50 hover:text-blue-700 transition cursor-pointer" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <%= recipient.name %>
          <% end %>
        <% end %>
      </div>
    <% elsif current_admin.recipients.empty? %>
      <p class="text-sm text-gray-400 mb-4">
        No recipients yet. <%= link_to "Add recipients", admin_recipients_path, class: "text-blue-600 hover:text-blue-800" %> first, then share this video with them.
      </p>
    <% end %>

    <!-- Already shared -->
    <% if video_shares.any? %>
      <div class="divide-y divide-gray-100">
        <% video_shares.each do |share| %>
          <% recipient = share.recipient %>
          <% voting_url = share.preview_url(request) %>
          <% voting_message = voting_url %>
          <% video_message = @video.youtube_url.present? ? "#{@video.youtube_url}#{@video.share_message.present? ? "\n\n#{@video.share_message}" : ''}" : nil %>
          <div class="flex items-center justify-between py-3 group">
            <div class="flex items-center gap-3 flex-1 min-w-0">
              <div class="w-8 h-8 rounded-full bg-purple-600 flex items-center justify-center text-white text-sm font-medium flex-shrink-0">
                <%= recipient.name[0].upcase %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900"><%= recipient.name %></p>
                <div class="flex items-center gap-2 mt-1">
                  <!-- Share voting URL button (always visible) -->
                  <button
                    type="button"
                    onclick="shareWithFeedback(this, '<%= j(recipient.share_url.to_s) %>', '<%= j(voting_message) %>')"
                    class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 px-2 py-1 rounded-md transition cursor-pointer"
                    title="Share voting link with <%= recipient.name %>"
                  >
                    <svg class="w-3.5 h-3.5 share-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                    <svg class="w-3.5 h-3.5 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    <span class="btn-label">Vote</span>
                  </button>
                  <!-- Share video URL button (only if recipient has share URL and video has YouTube URL) -->
                  <% if recipient.share_url.present? && video_message.present? %>
                    <button
                      type="button"
                      onclick="shareWithFeedback(this, '<%= j(recipient.share_url.to_s) %>', '<%= j(video_message) %>')"
                      class="inline-flex items-center gap-1 text-xs font-medium text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 px-2 py-1 rounded-md transition cursor-pointer"
                      title="Share video link with <%= recipient.name %>"
                    >
                      <svg class="w-3.5 h-3.5 share-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                      <svg class="w-3.5 h-3.5 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                      <span class="btn-label">Video</span>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 ml-3">
              <%
                name = recipient.name
                variant_rank_count = @video.variant_votes.count { |v| v.voter_name == name }
                total_variant_count = @video.variants.size
                has_variant_rankings = variant_rank_count == total_variant_count && total_variant_count > 0
                variants_with_pairs = @video.variants.select { |v| v.title_thumbnail_pairs.any? }
                pair_votes_cast = variants_with_pairs.count { |v| v.pair_votes.any? { |pv| pv.voter_name == name } }
                total_pair_slots = variants_with_pairs.size
                all_done = has_variant_rankings && pair_votes_cast == total_pair_slots && total_pair_slots > 0
                has_any_vote = variant_rank_count > 0 || pair_votes_cast > 0
              %>
              <% if all_done %>
                <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-medium">All done</span>
              <% elsif has_any_vote %>
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= has_variant_rankings ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                    Variants: <%= variant_rank_count %>/<%= total_variant_count %>
                  </span>
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= pair_votes_cast == total_pair_slots ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                    Pairs: <%= pair_votes_cast %>/<%= total_pair_slots %>
                  </span>
                </div>
              <% else %>
                <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">Not yet voted</span>
              <% end %>
              <%= button_to clear_votes_admin_video_video_share_path(@video, share), method: :delete, class: "text-gray-300 hover:text-red-500 transition p-1 cursor-pointer", title: "Clear #{recipient.name}'s votes", data: { turbo_confirm: "Clear #{recipient.name}'s votes? They keep access to this video." } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              <% end %>
              <%= button_to admin_video_video_share_path(@video, share), method: :delete, class: "text-gray-300 hover:text-red-500 transition p-1 cursor-pointer", title: "Remove #{recipient.name}'s access", data: { turbo_confirm: "Remove #{recipient.name}'s access? Their votes will remain." } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <% if current_admin.recipients.any? %>
        <p class="text-sm text-gray-400 text-center py-4">Not shared with anyone yet. Click a name above to share.</p>
      <% end %>
    <% end %>
  </div>
</details>

<script>
  function shareWithFeedback(btn, shareUrl, message) {
    var shareIcon = btn.querySelector('.share-icon');
    var checkIcon = btn.querySelector('.check-icon');
    var label = btn.querySelector('.btn-label');
    var originalLabel = label.textContent;

    navigator.clipboard.writeText(message).then(function() {
      // Show "Copied!" feedback on the button
      shareIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      label.textContent = 'Copied!';

      // Revert after 2 seconds
      setTimeout(function() {
        shareIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
        label.textContent = originalLabel;
      }, 2000);

      // Open Google Messages conversation if URL is set
      if (shareUrl && shareUrl.length > 0) {
        window.open(shareUrl, '_blank');
      }
    }).catch(function() {
      window.prompt('Copy this message:', message);
      if (shareUrl && shareUrl.length > 0) {
        window.open(shareUrl, '_blank');
      }
    });
  }
</script>

<!-- ==================== VARIANTS ==================== -->
<div class="flex justify-between items-center mb-4">
  <h2 class="text-lg font-semibold text-gray-900">Variants</h2>
  <%= link_to "Add Variant", new_admin_video_variant_path(@video), class: "text-sm bg-red-600 text-white px-3 py-1.5 rounded-md hover:bg-red-700 transition" %>
</div>

<% if @video.variants.empty? %>
  <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
    <p class="text-gray-500 mb-3">No variants yet</p>
    <p class="text-sm text-gray-400">Create variants to start mixing titles and thumbnails.</p>
  </div>
<% else %>
  <div class="space-y-8">
    <% @video.variants.each do |variant| %>
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <!-- Variant Header -->
        <div class="flex justify-between items-center px-5 py-3 bg-gray-50 border-b border-gray-200">
          <div class="flex items-center gap-3">
            <h3 class="font-semibold text-gray-900"><%= variant.name %></h3>
            <span class="text-xs text-gray-500"><%= variant.title_thumbnail_pairs.size %> pair<%= variant.title_thumbnail_pairs.size == 1 ? '' : 's' %></span>
          </div>
          <div class="flex items-center gap-2">
            <%= button_to move_admin_video_variant_path(@video, variant, direction: "up"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            <% end %>
            <%= button_to move_admin_video_variant_path(@video, variant, direction: "down"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            <% end %>
            <span class="text-gray-200">|</span>
            <%= link_to "Add Pair", new_admin_video_variant_pair_path(@video, variant), class: "text-xs bg-gray-200 text-gray-700 px-2.5 py-1 rounded-md hover:bg-gray-300 transition" %>
            <%= link_to "Edit", edit_admin_video_variant_path(@video, variant), class: "text-xs text-gray-500 hover:text-gray-700" %>
            <%= button_to "Remove", admin_video_variant_path(@video, variant), method: :delete, class: "text-xs text-red-500 hover:text-red-700", data: { turbo_confirm: "Delete this variant?" } %>
          </div>
        </div>

        <!-- Pairs as YouTube Cards -->
        <div class="p-5">
          <% if variant.title_thumbnail_pairs.empty? %>
            <p class="text-sm text-gray-400 text-center py-4">No title/thumbnail pairs yet. <%= link_to "Add one", new_admin_video_variant_pair_path(@video, variant), class: "text-red-600 hover:text-red-700" %></p>
          <% else %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <% variant.title_thumbnail_pairs.each do |pair| %>
                <div class="group relative">
                  <!-- YouTube Card Preview -->
                  <div class="yt-card">
                    <!-- Thumbnail -->
                    <div class="relative aspect-video bg-gray-200 rounded-xl overflow-hidden">
                      <% if pair.has_thumbnail? %>
                        <% if pair.thumbnail.attached? %>
                          <%= image_tag pair.thumbnail, class: "w-full h-full object-cover" %>
                        <% else %>
                          <img src="<%= pair.thumbnail_url %>" class="w-full h-full object-cover" alt="" loading="lazy">
                        <% end %>
                      <% else %>
                        <div class="w-full h-full flex items-center justify-center text-gray-400">
                          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                        </div>
                      <% end %>
                      <% if @video.video_duration.present? %>
                        <span class="absolute bottom-1 right-1 bg-black/80 text-white font-medium px-1 rounded" style="font-size: 11px; line-height: 16px; letter-spacing: 0.5px;"><%= @video.video_duration %></span>
                      <% end %>
                    </div>

                    <!-- Info -->
                    <div class="flex gap-3 mt-3">
                      <% if current_admin.avatar_url %>
                        <img src="<%= current_admin.avatar_url %>" class="w-9 h-9 rounded-full flex-shrink-0" alt="" referrerpolicy="no-referrer">
                      <% else %>
                        <div class="w-9 h-9 rounded-full bg-red-600 flex items-center justify-center text-white text-sm font-medium flex-shrink-0">
                          <%= current_admin.yt_username[0].upcase %>
                        </div>
                      <% end %>
                      <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-medium text-gray-900 leading-5 line-clamp-2"><%= pair.title %></h4>
                        <p class="text-xs text-gray-500 mt-1"><%= current_admin.yt_username %></p>
                        <p class="text-xs text-gray-500"><%= @video.sample_views %> &middot; 1 hour ago</p>
                      </div>
                    </div>
                  </div>

                  <!-- Actions -->
                  <div class="mt-2 flex items-center gap-1">
                    <%= button_to move_admin_video_variant_pair_path(@video, variant, pair, direction: "up"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    <% end %>
                    <%= button_to move_admin_video_variant_pair_path(@video, variant, pair, direction: "down"), method: :patch, class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition cursor-pointer" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    <% end %>
                    <span class="mx-1 text-gray-200">|</span>
                    <%= link_to edit_admin_video_variant_pair_path(@video, variant, pair), class: "text-gray-400 hover:text-gray-700 p-1 rounded hover:bg-gray-100 transition" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                    <% end %>
                    <%= button_to admin_video_variant_pair_path(@video, variant, pair), method: :delete, class: "text-red-300 hover:text-red-600 p-1 rounded hover:bg-red-50 transition cursor-pointer", data: { turbo_confirm: "Delete this pair?" } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
