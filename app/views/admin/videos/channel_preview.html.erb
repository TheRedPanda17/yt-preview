<div class="mx-auto max-w-5xl">
  <div class="mb-6 flex items-start justify-between gap-4">
    <div>
      <%= link_to "&larr; Back to #{@video.working_title}".html_safe, admin_video_path(@video), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <h1 class="mt-2 text-2xl font-bold text-gray-900">Choose Channel Preview</h1>
      <p class="mt-1 text-sm text-gray-500">Select the saved title and thumbnail pair you want to see in the full channel preview.</p>
    </div>
    <%= link_to "Create more pairs", compose_admin_video_path(@video), class: "text-sm bg-red-600 text-white px-3 py-1.5 rounded-md hover:bg-red-700 transition whitespace-nowrap" %>
  </div>

  <% if @preview_pairs.empty? %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center">
      <p class="font-medium text-gray-900">No preview variants yet</p>
      <p class="mt-1 text-sm text-gray-500">Save at least one title and thumbnail pair before opening a channel preview.</p>
      <%= link_to "Create Pairs", compose_admin_video_path(@video), class: "mt-4 inline-flex rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" %>
    </div>
  <% else %>
    <div class="space-y-8">
      <% @video.variants.each do |variant| %>
        <% pairs = variant.title_thumbnail_pairs.select(&:has_thumbnail?) %>
        <% next if pairs.empty? %>

        <section class="rounded-xl border border-gray-200 bg-white">
          <div class="border-b border-gray-200 px-5 py-4">
            <h2 class="font-semibold text-gray-900"><%= variant.name %></h2>
            <p class="mt-0.5 text-xs text-gray-500"><%= pairs.size %> preview option<%= pairs.size == 1 ? "" : "s" %></p>
          </div>

          <div class="grid grid-cols-1 gap-5 p-5 sm:grid-cols-2 lg:grid-cols-3">
            <% pairs.each do |pair| %>
              <%= link_to channel_preview_pair_admin_video_path(@video, pair), class: "group block rounded-xl border border-gray-200 p-3 transition hover:border-gray-300 hover:shadow-sm" do %>
                <div class="relative aspect-video overflow-hidden rounded-lg bg-gray-200">
                  <% if pair.thumbnail.attached? %>
                    <%= image_tag pair.thumbnail, class: "h-full w-full object-cover" %>
                  <% else %>
                    <img src="<%= pair.thumbnail_url %>" class="h-full w-full object-cover" alt="" loading="lazy">
                  <% end %>
                  <% if @video.video_duration.present? %>
                    <span class="absolute bottom-1 right-1 rounded bg-black/80 px-1 font-medium text-white" style="font-size: 11px; line-height: 16px; letter-spacing: 0.5px;"><%= @video.video_duration %></span>
                  <% end %>
                </div>
                <div class="mt-3 flex gap-3">
                  <% if current_admin.avatar_url %>
                    <img src="<%= current_admin.avatar_url %>" class="h-9 w-9 flex-shrink-0 rounded-full" alt="" referrerpolicy="no-referrer">
                  <% else %>
                    <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-red-600 text-sm font-medium text-white">
                      <%= current_admin.yt_username[0].upcase %>
                    </div>
                  <% end %>
                  <div class="min-w-0 flex-1">
                    <h3 class="line-clamp-2 text-sm font-medium leading-5 text-gray-900 group-hover:text-red-700"><%= pair.title %></h3>
                    <p class="mt-1 text-xs text-gray-500"><%= @video.sample_views %> &middot; Preview</p>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
