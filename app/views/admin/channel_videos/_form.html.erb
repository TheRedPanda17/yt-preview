<%= form_with model: [:admin, @channel_video], multipart: true, class: "space-y-4 max-w-xl" do |f| %>
  <% if @channel_video.errors.any? %>
    <div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm">
      <ul class="list-disc list-inside">
        <% @channel_video.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @channel_video.has_thumbnail? %>
    <div>
      <p class="text-sm font-medium text-gray-700 mb-2">Current Thumbnail</p>
      <div class="aspect-video w-72 bg-gray-200 rounded-lg overflow-hidden">
        <% if @channel_video.thumbnail.attached? %>
          <%= image_tag @channel_video.thumbnail, class: "w-full h-full object-cover" %>
        <% elsif @channel_video.thumbnail_url.present? %>
          <img src="<%= @channel_video.thumbnail_url %>" class="w-full h-full object-cover" alt="">
        <% end %>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "YouTube Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, required: true, autofocus: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 px-3 py-2 border" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :view_count, "View Count", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :view_count, placeholder: "1.2K views", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 px-3 py-2 border" %>
    </div>

    <div>
      <%= f.label :published_at_label, "Posted", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :published_at_label, placeholder: "3 days ago", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 px-3 py-2 border" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :duration, "Duration", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :duration, placeholder: "10:30", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 px-3 py-2 border" %>
    </div>

    <div>
      <%= f.label :position, "Position", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :position, min: 0, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 px-3 py-2 border" %>
    </div>
  </div>

  <div>
    <%= f.label :youtube_url, "YouTube URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :youtube_url, placeholder: "https://www.youtube.com/watch?v=...", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 px-3 py-2 border" %>
  </div>

  <div>
    <%= f.label :thumbnail, "Upload Thumbnail", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.file_field :thumbnail, accept: "image/*", class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-red-50 file:text-red-700 hover:file:bg-red-100" %>
  </div>

  <div class="relative">
    <div class="absolute inset-0 flex items-center" aria-hidden="true">
      <div class="w-full border-t border-gray-200"></div>
    </div>
    <div class="relative flex justify-center">
      <span class="bg-gray-50 px-3 text-xs text-gray-400">or</span>
    </div>
  </div>

  <div>
    <%= f.label :thumbnail_url, "Thumbnail URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :thumbnail_url, placeholder: "https://img.youtube.com/vi/.../maxresdefault.jpg", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 px-3 py-2 border" %>
  </div>

  <div class="pt-2 flex items-center gap-3">
    <%= f.submit class: "bg-red-600 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-red-700 transition cursor-pointer" %>
    <%= link_to "Cancel", admin_channel_videos_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
